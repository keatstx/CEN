{
  "module_name": "benefits_enrollment_navigator",
  "version": "2.0",
  "description": "End-to-end benefits enrollment: Medicare check, household composition split, state-specific Medicaid rules, document collection, real subsidy calculation, application submission per program, determination tracking, plan selection, enrollment confirmation, premium payment setup, and renewal scheduling.",
  "nodes": [
    {
      "id": "intake_start",
      "type": "ACTION",
      "metadata": {
        "label": "Case Intake Start",
        "input_schema": [
          {
            "key": "patient_name",
            "label": "Patient name",
            "type": "text",
            "required": true,
            "description": "First and last name as shown on the bill or insurance card."
          },
          {
            "key": "patient_dob",
            "label": "Patient date of birth",
            "type": "date",
            "required": true
          },
          {
            "key": "patient_phone",
            "label": "Best phone number to reach the patient",
            "type": "text",
            "required": false,
            "description": "Optional - so we can follow up if needed."
          }
        ],
        "tags": [
          "function:intake"
        ]
      }
    },
    {
      "id": "consent",
      "type": "APPROVAL",
      "metadata": {
        "label": "Consent & ROI",
        "auto_set": {
          "consent_granted": true
        },
        "tags": [
          "function:consent"
        ]
      }
    },
    {
      "id": "collect_household",
      "type": "ACTION",
      "metadata": {
        "label": "Household Data Collection",
        "description": "Size, income, state, dependents, ages, immigration status, disability, pregnancy.",
        "input_schema": [
          {
            "key": "household_size",
            "label": "How many people live in the household?",
            "type": "number",
            "required": true,
            "description": "Count everyone who lives there, including children and dependents."
          },
          {
            "key": "annual_household_income",
            "label": "Total annual household income",
            "type": "currency",
            "required": true,
            "description": "Combined income for everyone in the household, before taxes."
          },
          {
            "key": "has_children_under_19",
            "label": "Are there children under 19 in the household?",
            "type": "boolean",
            "required": false
          }
        ],
        "tags": [
          "function:document_collection"
        ]
      }
    },
    {
      "id": "medicare_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Medicare Eligible?",
        "input_schema": [
          {
            "key": "medicare_eligible",
            "label": "Is the patient Medicare-eligible?",
            "type": "boolean",
            "required": true,
            "description": "Yes if the patient is 65+, has been on SSDI for 24+ months, or has ESRD/ALS."
          }
        ],
        "tags": [
          "domain:medicare",
          "function:eligibility_check"
        ]
      },
      "condition_field": "medicare_eligible",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "medicare_path",
      "false_next": "household_split"
    },
    {
      "id": "medicare_path",
      "type": "ACTION",
      "metadata": {
        "label": "Medicare Enrollment Path",
        "description": "Original Medicare, Part D, Medigap, MA plan selection, LIS, MSP screening.",
        "tags": [
          "domain:medicare"
        ]
      }
    },
    {
      "id": "household_split",
      "type": "ACTION",
      "metadata": {
        "label": "Household Composition Split",
        "description": "Separate adults, children, pregnant members, disabled members for parallel eligibility.",
        "tags": [
          "function:eligibility_check"
        ]
      }
    },
    {
      "id": "state_rule_lookup",
      "type": "ACTION",
      "metadata": {
        "label": "State Rule Lookup",
        "description": "Load state-specific Medicaid expansion status, MAGI thresholds, non-MAGI categories, waivers.",
        "tags": [
          "domain:medicaid",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "document_intake",
      "type": "ACTION",
      "metadata": {
        "label": "Document Collection",
        "description": "Income proof, citizenship/immigration docs, residency, SSN, disability records.",
        "tags": [
          "function:document_collection"
        ]
      }
    },
    {
      "id": "subsidy_calculator",
      "type": "ACTION",
      "metadata": {
        "label": "APTC/CSR Subsidy Calculator",
        "description": "Real PTC and CSR math based on FPL, age, region, plan benchmark.",
        "tags": [
          "domain:marketplace",
          "function:calculation"
        ]
      }
    },
    {
      "id": "eligibility_matrix",
      "type": "ACTION",
      "metadata": {
        "label": "Eligibility Matrix",
        "description": "Run each household member through Medicaid, CHIP, ACA, Medicare Savings, ABD waivers.",
        "tags": [
          "domain:medicare",
          "function:eligibility_check"
        ]
      }
    },
    {
      "id": "medicaid_branch",
      "type": "CONDITION",
      "metadata": {
        "label": "Any Medicaid Eligible?",
        "input_schema": [
          {
            "key": "medicaid_eligible_count",
            "label": "How many people in the household qualify for Medicaid?",
            "type": "number",
            "required": true,
            "description": "Enter 0 if no one qualifies."
          }
        ],
        "tags": [
          "domain:medicaid",
          "function:eligibility_check"
        ]
      },
      "condition_field": "medicaid_eligible_count",
      "condition_operator": ">",
      "condition_value": 0,
      "true_next": "medicaid_application",
      "false_next": "chip_branch"
    },
    {
      "id": "medicaid_application",
      "type": "ACTION",
      "metadata": {
        "label": "Medicaid Application",
        "description": "State-specific submission (e.g., Illinois ABE) for eligible members.",
        "tags": [
          "domain:medicaid",
          "function:eligibility_check"
        ]
      }
    },
    {
      "id": "chip_branch",
      "type": "CONDITION",
      "metadata": {
        "label": "Any CHIP Eligible Children?",
        "input_schema": [
          {
            "key": "chip_eligible_count",
            "label": "How many children in the household qualify for CHIP?",
            "type": "number",
            "required": true,
            "description": "Enter 0 if no children qualify."
          }
        ],
        "tags": [
          "function:eligibility_check"
        ]
      },
      "condition_field": "chip_eligible_count",
      "condition_operator": ">",
      "condition_value": 0,
      "true_next": "chip_application",
      "false_next": "aca_branch"
    },
    {
      "id": "chip_application",
      "type": "ACTION",
      "metadata": {
        "label": "CHIP Application (e.g., All Kids)"
      }
    },
    {
      "id": "aca_branch",
      "type": "CONDITION",
      "metadata": {
        "label": "Any ACA Eligible?",
        "input_schema": [
          {
            "key": "aca_eligible_count",
            "label": "How many people qualify for an ACA marketplace plan?",
            "type": "number",
            "required": true,
            "description": "Enter 0 if no one qualifies."
          }
        ],
        "tags": [
          "function:eligibility_check"
        ]
      },
      "condition_field": "aca_eligible_count",
      "condition_operator": ">",
      "condition_value": 0,
      "true_next": "sep_check",
      "false_next": "no_program_match"
    },
    {
      "id": "sep_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Open Enrollment or SEP?",
        "input_schema": [
          {
            "key": "enrollment_window_open",
            "label": "Is open enrollment currently open, or does the patient qualify for a Special Enrollment Period?",
            "type": "boolean",
            "required": true,
            "description": "Special enrollment is triggered by life events: job loss, marriage, birth, moving, etc."
          }
        ]
      },
      "condition_field": "enrollment_window_open",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "plan_selection",
      "false_next": "sep_qualification"
    },
    {
      "id": "sep_qualification",
      "type": "ACTION",
      "metadata": {
        "label": "SEP Qualifying Event Verification",
        "tags": [
          "function:identity_verification"
        ]
      }
    },
    {
      "id": "plan_selection",
      "type": "ACTION",
      "metadata": {
        "label": "Plan Selection Engine",
        "description": "Compare premium, deductible, network, formulary, OOP max for household needs.",
        "tags": [
          "domain:marketplace"
        ]
      }
    },
    {
      "id": "aca_application",
      "type": "ACTION",
      "metadata": {
        "label": "ACA Marketplace Application",
        "description": "Submit via healthcare.gov or state exchange.",
        "tags": [
          "domain:marketplace",
          "function:submission"
        ]
      }
    },
    {
      "id": "no_program_match",
      "type": "ACTION",
      "metadata": {
        "label": "No Program Match",
        "description": "Document gap; route to community resource router and Guild.",
        "tags": [
          "function:document_collection"
        ]
      }
    },
    {
      "id": "submission_tracker",
      "type": "ACTION",
      "metadata": {
        "label": "Submission Tracker",
        "description": "Track each program submission with confirmation number and SLA.",
        "tags": [
          "function:submission"
        ]
      }
    },
    {
      "id": "determination_wait",
      "type": "ACTION",
      "metadata": {
        "label": "Determination Wait State",
        "tags": [
          "function:tracking"
        ]
      }
    },
    {
      "id": "determination_received",
      "type": "CONDITION",
      "metadata": {
        "label": "Determination Received?",
        "input_schema": [
          {
            "key": "all_determinations_in",
            "label": "Have all benefit determinations been received from the agencies?",
            "type": "boolean",
            "required": true,
            "description": "Mark Yes only after every program (Medicaid, CHIP, ACA, etc.) has responded."
          }
        ],
        "tags": [
          "function:tracking"
        ]
      },
      "condition_field": "all_determinations_in",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "determination_router",
      "false_next": "determination_router"
    },
    {
      "id": "determination_router",
      "type": "CONDITION",
      "metadata": {
        "label": "Approved or Denied?",
        "input_schema": [
          {
            "key": "any_denied",
            "label": "Was any benefit application denied?",
            "type": "boolean",
            "required": true
          }
        ],
        "tags": [
          "function:approval"
        ]
      },
      "condition_field": "any_denied",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "denial_appeal",
      "false_next": "enrollment_confirmation"
    },
    {
      "id": "denial_appeal",
      "type": "ACTION",
      "metadata": {
        "label": "Eligibility Denial Appeal",
        "tags": [
          "function:eligibility_check"
        ]
      }
    },
    {
      "id": "enrollment_confirmation",
      "type": "ACTION",
      "metadata": {
        "label": "Enrollment Confirmation",
        "description": "Capture effective date, member IDs, plan details.",
        "tags": [
          "domain:marketplace"
        ]
      }
    },
    {
      "id": "premium_payment_setup",
      "type": "ACTION",
      "metadata": {
        "label": "Premium Payment Setup",
        "description": "Set up first month's premium and recurring payment."
      }
    },
    {
      "id": "id_card_delivery",
      "type": "ACTION",
      "metadata": {
        "label": "ID Card & Welcome Packet Tracking",
        "tags": [
          "function:tracking"
        ]
      }
    },
    {
      "id": "renewal_scheduler",
      "type": "ACTION",
      "metadata": {
        "label": "Renewal & Redetermination Scheduler",
        "tags": [
          "function:tracking"
        ]
      }
    },
    {
      "id": "outcome_capture",
      "type": "ACTION",
      "metadata": {
        "label": "Outcome Capture",
        "description": "Members enrolled, programs, annual subsidy value, OOP savings.",
        "tags": [
          "domain:marketplace",
          "function:calculation"
        ]
      }
    },
    {
      "id": "patient_notification",
      "type": "ACTION",
      "metadata": {
        "label": "Patient Notification",
        "tags": [
          "function:notification"
        ]
      }
    },
    {
      "id": "case_close",
      "type": "ACTION",
      "metadata": {
        "label": "Case Close",
        "tags": [
          "function:closeout"
        ]
      }
    }
  ],
  "edges": [
    {
      "source": "intake_start",
      "target": "consent"
    },
    {
      "source": "consent",
      "target": "collect_household"
    },
    {
      "source": "collect_household",
      "target": "medicare_check"
    },
    {
      "source": "medicare_check",
      "target": "medicare_path",
      "label": "yes"
    },
    {
      "source": "medicare_check",
      "target": "household_split",
      "label": "no"
    },
    {
      "source": "medicare_path",
      "target": "household_split"
    },
    {
      "source": "household_split",
      "target": "state_rule_lookup"
    },
    {
      "source": "state_rule_lookup",
      "target": "document_intake"
    },
    {
      "source": "document_intake",
      "target": "subsidy_calculator"
    },
    {
      "source": "subsidy_calculator",
      "target": "eligibility_matrix"
    },
    {
      "source": "eligibility_matrix",
      "target": "medicaid_branch"
    },
    {
      "source": "medicaid_branch",
      "target": "medicaid_application",
      "label": "eligible"
    },
    {
      "source": "medicaid_branch",
      "target": "chip_branch",
      "label": "none"
    },
    {
      "source": "medicaid_application",
      "target": "chip_branch"
    },
    {
      "source": "chip_branch",
      "target": "chip_application",
      "label": "eligible"
    },
    {
      "source": "chip_branch",
      "target": "aca_branch",
      "label": "none"
    },
    {
      "source": "chip_application",
      "target": "aca_branch"
    },
    {
      "source": "aca_branch",
      "target": "sep_check",
      "label": "eligible"
    },
    {
      "source": "aca_branch",
      "target": "no_program_match",
      "label": "none"
    },
    {
      "source": "sep_check",
      "target": "plan_selection",
      "label": "open"
    },
    {
      "source": "sep_check",
      "target": "sep_qualification",
      "label": "closed"
    },
    {
      "source": "sep_qualification",
      "target": "plan_selection"
    },
    {
      "source": "plan_selection",
      "target": "aca_application"
    },
    {
      "source": "aca_application",
      "target": "submission_tracker"
    },
    {
      "source": "no_program_match",
      "target": "submission_tracker"
    },
    {
      "source": "submission_tracker",
      "target": "determination_wait"
    },
    {
      "source": "determination_wait",
      "target": "determination_received"
    },
    {
      "source": "determination_received",
      "target": "determination_router",
      "label": "received"
    },
    {
      "source": "determination_router",
      "target": "denial_appeal",
      "label": "denied"
    },
    {
      "source": "determination_router",
      "target": "enrollment_confirmation",
      "label": "approved"
    },
    {
      "source": "denial_appeal",
      "target": "enrollment_confirmation"
    },
    {
      "source": "enrollment_confirmation",
      "target": "premium_payment_setup"
    },
    {
      "source": "premium_payment_setup",
      "target": "id_card_delivery"
    },
    {
      "source": "id_card_delivery",
      "target": "renewal_scheduler"
    },
    {
      "source": "renewal_scheduler",
      "target": "outcome_capture"
    },
    {
      "source": "outcome_capture",
      "target": "patient_notification"
    },
    {
      "source": "patient_notification",
      "target": "case_close"
    }
  ]
}
