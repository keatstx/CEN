{
  "module_name": "community_resource_router",
  "version": "2.0",
  "description": "End-to-end SDOH workflow: full domain screening (PRAPARE/AHC-HRSN), real resource database lookup, eligibility filtering, warm handoff submission, appointment scheduling, closed-loop confirmation, follow-up cadence, outcome capture, and re-screening trigger.",
  "nodes": [
    {
      "id": "intake_start",
      "type": "ACTION",
      "metadata": {
        "label": "Case Intake Start",
        "input_schema": [
          {
            "key": "patient_name",
            "label": "Patient name",
            "type": "text",
            "required": true,
            "description": "First and last name as shown on the bill or insurance card."
          },
          {
            "key": "patient_dob",
            "label": "Patient date of birth",
            "type": "date",
            "required": true
          },
          {
            "key": "patient_phone",
            "label": "Best phone number to reach the patient",
            "type": "text",
            "required": false,
            "description": "Optional - so we can follow up if needed."
          }
        ],
        "tags": [
          "domain:sdoh",
          "function:intake"
        ]
      }
    },
    {
      "id": "consent",
      "type": "APPROVAL",
      "metadata": {
        "label": "Consent & Data Sharing",
        "auto_set": {
          "consent_granted": true
        },
        "tags": [
          "domain:sdoh",
          "function:consent"
        ]
      }
    },
    {
      "id": "sdoh_screener",
      "type": "ACTION",
      "metadata": {
        "label": "Full SDOH Screener",
        "description": "PRAPARE + AHC-HRSN: housing, food, utilities, transport, childcare, employment, legal, behavioral health, substance use, IPV, immigration, veterans, prescription, dental, vision, tech access, education.",
        "input_schema": [
          {
            "key": "needs_housing",
            "label": "Does the patient need help with housing?",
            "type": "boolean",
            "required": false
          },
          {
            "key": "needs_food",
            "label": "Does the patient need help with food?",
            "type": "boolean",
            "required": false
          },
          {
            "key": "needs_transport",
            "label": "Does the patient need help with transportation?",
            "type": "boolean",
            "required": false
          },
          {
            "key": "needs_utilities",
            "label": "Does the patient need help with utility bills?",
            "type": "boolean",
            "required": false
          },
          {
            "key": "zip_code",
            "label": "Patient ZIP code",
            "type": "text",
            "required": true,
            "description": "Used to find local resources."
          }
        ],
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "needs_aggregation",
      "type": "ACTION",
      "metadata": {
        "label": "Needs Aggregation & Prioritization",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "domain_router",
      "type": "ACTION",
      "metadata": {
        "label": "Domain Router (Parallel Fan-Out)",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "housing",
      "type": "ACTION",
      "metadata": {
        "label": "Housing Domain Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "food",
      "type": "ACTION",
      "metadata": {
        "label": "Food Domain Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "utilities",
      "type": "ACTION",
      "metadata": {
        "label": "Utilities (LIHEAP) Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "transport",
      "type": "ACTION",
      "metadata": {
        "label": "Transportation Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "childcare",
      "type": "ACTION",
      "metadata": {
        "label": "Childcare Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "employment",
      "type": "ACTION",
      "metadata": {
        "label": "Employment & Workforce Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "legal",
      "type": "ACTION",
      "metadata": {
        "label": "Legal Aid Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "behavioral_health",
      "type": "ACTION",
      "metadata": {
        "label": "Behavioral Health Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "substance_use",
      "type": "ACTION",
      "metadata": {
        "label": "Substance Use Treatment Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "ipv",
      "type": "ACTION",
      "metadata": {
        "label": "Domestic Violence Safety Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "immigration",
      "type": "ACTION",
      "metadata": {
        "label": "Immigration Services Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "veterans",
      "type": "ACTION",
      "metadata": {
        "label": "Veterans Services Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "prescription",
      "type": "ACTION",
      "metadata": {
        "label": "Prescription Assistance Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "dental_vision",
      "type": "ACTION",
      "metadata": {
        "label": "Dental & Vision Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "tech_access",
      "type": "ACTION",
      "metadata": {
        "label": "Technology Access Lookup",
        "tags": [
          "domain:sdoh",
          "function:policy_lookup"
        ]
      }
    },
    {
      "id": "resource_db_query",
      "type": "ACTION",
      "metadata": {
        "label": "Resource Database Query",
        "description": "Query findhelp/Aunt Bertha, 211, NowPow, Unite Us, and ThriveAI local index by ZIP.",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "eligibility_filter",
      "type": "ACTION",
      "metadata": {
        "label": "Eligibility Filter",
        "description": "Filter results by income, geography, age, language, insurance, immigration status.",
        "tags": [
          "domain:sdoh",
          "function:eligibility_check"
        ]
      }
    },
    {
      "id": "consolidate_resources",
      "type": "ACTION",
      "metadata": {
        "label": "Consolidate Resource Plan",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "warm_handoff",
      "type": "ACTION",
      "metadata": {
        "label": "Warm Handoff Submission",
        "description": "Submit electronic referrals via Unite Us / NowPow / direct API.",
        "tags": [
          "domain:sdoh",
          "function:submission"
        ]
      }
    },
    {
      "id": "appointment_scheduler",
      "type": "ACTION",
      "metadata": {
        "label": "Appointment Scheduling",
        "description": "Book intake appointments where supported.",
        "tags": [
          "domain:sdoh",
          "function:intake"
        ]
      }
    },
    {
      "id": "patient_confirmation",
      "type": "CONDITION",
      "metadata": {
        "label": "Patient Confirmed Receipt?",
        "input_schema": [
          {
            "key": "patient_confirmed",
            "label": "Did the patient confirm they want to be referred to these resources?",
            "type": "boolean",
            "required": true
          }
        ],
        "tags": [
          "domain:sdoh"
        ]
      },
      "condition_field": "patient_confirmed",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "service_followup",
      "false_next": "navigator_outreach"
    },
    {
      "id": "navigator_outreach",
      "type": "HANDOFF",
      "metadata": {
        "label": "Navigator Outreach",
        "tags": [
          "domain:sdoh",
          "function:escalation"
        ]
      }
    },
    {
      "id": "service_followup",
      "type": "ACTION",
      "metadata": {
        "label": "Service Follow-Up",
        "description": "7-day, 30-day, 90-day check-ins.",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "closed_loop",
      "type": "CONDITION",
      "metadata": {
        "label": "Service Received?",
        "input_schema": [
          {
            "key": "service_received",
            "label": "Has the patient received the service yet?",
            "type": "boolean",
            "required": true,
            "description": "Mark Yes once the patient has actually engaged with the resource (called, applied, or received help)."
          }
        ],
        "tags": [
          "domain:sdoh"
        ]
      },
      "condition_field": "service_received",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "outcome_capture",
      "false_next": "barrier_resolution"
    },
    {
      "id": "barrier_resolution",
      "type": "ACTION",
      "metadata": {
        "label": "Barrier Resolution",
        "description": "Identify why service was not received; alternate referral.",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "barrier_loop_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Retry Available?",
        "input_schema": [
          {
            "key": "retry_count",
            "label": "How many times has the patient tried to engage with this resource so far?",
            "type": "number",
            "required": true,
            "description": "Enter 0 for first attempt. Up to 2 retries are allowed before escalation."
          }
        ],
        "tags": [
          "domain:sdoh"
        ]
      },
      "condition_field": "retry_count",
      "condition_operator": "<",
      "condition_value": 2,
      "true_next": "guild_escalation",
      "false_next": "guild_escalation"
    },
    {
      "id": "guild_escalation",
      "type": "HANDOFF",
      "metadata": {
        "label": "Guild Escalation",
        "tags": [
          "domain:sdoh",
          "function:escalation"
        ]
      }
    },
    {
      "id": "outcome_capture",
      "type": "ACTION",
      "metadata": {
        "label": "Outcome Capture",
        "description": "Need met/partial/unmet, dollar value, service received date.",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "rescreen_scheduler",
      "type": "ACTION",
      "metadata": {
        "label": "Re-Screening Scheduler",
        "description": "Schedule SDOH re-screen at 90 or 180 days.",
        "tags": [
          "domain:sdoh"
        ]
      }
    },
    {
      "id": "patient_notification",
      "type": "ACTION",
      "metadata": {
        "label": "Patient Notification",
        "tags": [
          "domain:sdoh",
          "function:notification"
        ]
      }
    },
    {
      "id": "case_close",
      "type": "ACTION",
      "metadata": {
        "label": "Case Close",
        "tags": [
          "domain:sdoh",
          "function:closeout"
        ]
      }
    }
  ],
  "edges": [
