{
  "module_name": "charity_care_navigator",
  "version": "2.0",
  "description": "End-to-end charity care workflow: identity, consent, document collection, hospital-specific policy lookup, presumptive eligibility, application submission, status polling, denial/appeal loop, account reconciliation, patient notification, and case closure.",
  "nodes": [
    {
      "id": "intake_start",
      "type": "ACTION",
      "metadata": {
        "label": "Case Intake Start",
        "description": "Create case record and capture referral source.",
        "input_schema": [
          {
            "key": "patient_name",
            "label": "Patient name",
            "type": "text",
            "required": true,
            "description": "First and last name as shown on the bill or insurance card."
          },
          {
            "key": "patient_dob",
            "label": "Patient date of birth",
            "type": "date",
            "required": true
          },
          {
            "key": "patient_phone",
            "label": "Best phone number to reach the patient",
            "type": "text",
            "required": false,
            "description": "Optional - so we can follow up if needed."
          }
        ],
        "suggested_questions": [
          "What name should I use if the bill is in a different one?",
          "Do we need the patient's ID or insurance card now?",
          "What if the patient doesn't have a phone?"
        ]
      }
    },
    {
      "id": "identity_verification",
      "type": "ACTION",
      "metadata": {
        "label": "Identity Verification",
        "description": "Verify patient identity (name, DOB, SSN last 4, address).",
        "input_schema": [
          {
            "key": "patient_name",
            "label": "Patient name",
            "type": "text",
            "required": true,
            "description": "First and last name as shown on the bill or insurance card."
          },
          {
            "key": "patient_dob",
            "label": "Patient date of birth",
            "type": "date",
            "required": true
          },
          {
            "key": "patient_phone",
            "label": "Best phone number",
            "type": "text",
            "required": false,
            "description": "Optional - so we can follow up if needed."
          }
        ]
      }
    },
    {
      "id": "hipaa_consent",
      "type": "APPROVAL",
      "metadata": {
        "label": "HIPAA & Advocacy Consent",
        "description": "Obtain signed HIPAA authorization and advocacy consent.",
        "auto_set": {
          "consent_granted": true
        },
        "suggested_questions": [
          "What does the patient need to sign?",
          "How long is the HIPAA authorization good for?",
          "Can the patient revoke consent later?",
          "Do we need a separate form for advocacy?"
        ]
      }
    },
    {
      "id": "consent_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Consent Granted?"
      },
      "condition_field": "consent_granted",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "document_intake",
      "false_next": "case_close_no_consent"
    },
    {
      "id": "document_intake",
      "type": "ACTION",
      "metadata": {
        "label": "Document Collection",
        "description": "Collect pay stubs, tax returns, ID, proof of residency, household composition, hospital bill.",
        "input_schema": [
          {
            "key": "income_documentation",
            "label": "Upload proof of income (pay stub, W-2, or tax return)",
            "type": "file",
            "required": false,
            "description": "Optional - upload now if you have it, or we can collect later."
          },
          {
            "key": "income_documentation_notes",
            "label": "Notes about income documentation",
            "type": "text",
            "required": false,
            "description": "If the patient doesn't have documents yet, note what's missing."
          }
        ],
        "auto_set": {
          "documents_complete": true
        },
        "suggested_questions": [
          "What documents do we still need?",
          "Can we move forward without a pay stub?",
          "What if the patient is self-employed?",
          "How recent do the documents need to be?"
        ]
      }
    },
    {
      "id": "documents_complete",
      "type": "CONDITION",
      "metadata": {
        "label": "Documents Complete?"
      },
      "condition_field": "documents_complete",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "hospital_policy_lookup",
      "false_next": "document_followup"
    },
    {
      "id": "document_followup",
      "type": "ACTION",
      "metadata": {
        "label": "Document Follow-Up",
        "description": "SMS/email reminder to patient; pause case with SLA timer (7 days)."
      }
    },
    {
      "id": "document_followup_timer",
      "type": "CONDITION",
      "metadata": {
        "label": "Documents Received in 7 Days?"
      },
      "condition_field": "documents_complete",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "hospital_policy_lookup",
      "false_next": "navigator_outreach"
    },
    {
      "id": "navigator_outreach",
      "type": "HANDOFF",
      "metadata": {
        "label": "Navigator Manual Outreach",
        "description": "Local CEN attempts in-person or phone outreach."
      }
    },
    {
      "id": "hospital_policy_lookup",
      "type": "ACTION",
      "metadata": {
        "label": "Hospital Policy Lookup",
        "description": "Retrieve facility-specific charity care policy, FPL multiplier, and required forms from policy database."
      }
    },
    {
      "id": "income_verification",
      "type": "ACTION",
      "metadata": {
        "label": "Income Verification",
        "description": "Calculate household income vs FPL using collected documents."
      }
    },
    {
      "id": "presumptive_eligibility",
      "type": "CONDITION",
      "metadata": {
        "label": "Presumptive Eligibility?",
        "description": "Check Medicaid, SNAP, homeless, deceased, or other presumptive triggers.",
        "input_schema": [
          {
            "key": "presumptive_eligible",
            "label": "Does the patient qualify under any presumptive eligibility trigger?",
            "type": "boolean",
            "required": true,
            "description": "Patients on Medicaid, SNAP, WIC, TANF, or who are homeless or recently deceased usually qualify for automatic charity care without further proof."
          }
        ],
        "suggested_questions": [
          "What counts as presumptive eligibility?",
          "Does Medicaid alone qualify the patient?",
          "What if the patient is on SNAP but not Medicaid?",
          "How do I prove presumptive status?"
        ]
      },
      "condition_field": "presumptive_eligible",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "auto_app_full",
      "false_next": "fpl_tier_check"
    },
    {
      "id": "fpl_tier_check",
      "type": "CONDITION",
      "metadata": {
        "label": "FPL Tier Check",
        "description": "Compare income to hospital's full-write-off threshold.",
        "input_schema": [
          {
            "key": "income_fpl_percent",
            "label": "Patient household income as % of Federal Poverty Level",
            "type": "number",
            "required": true,
            "description": "Use the household income calculator. Enter 100 for 100% of FPL, 200 for 200%, etc."
          }
        ],
        "suggested_questions": [
          "How do I calculate income as a percent of FPL?",
          "What income counts toward the household total?",
          "What's the threshold for full write-off at this hospital?",
          "Do I include the spouse's income?"
        ]
      },
      "condition_field": "income_fpl_percent",
      "condition_operator": "<",
      "condition_value_field": "hospital_full_writeoff_threshold",
      "true_next": "auto_app_full",
      "false_next": "sliding_scale_check"
    },
    {
      "id": "sliding_scale_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Sliding Scale Eligible?",
        "input_schema": [
          {
            "key": "income_fpl_percent",
            "label": "Patient household income as % of Federal Poverty Level",
            "type": "number",
            "required": true,
            "description": "Use the household income calculator. Enter 100 for 100% of FPL, 200 for 200%, etc."
          }
        ]
      },
      "condition_field": "income_fpl_percent",
      "condition_operator": "<",
      "condition_value_field": "hospital_partial_threshold",
      "true_next": "auto_app_partial",
      "false_next": "route_to_debt_engine"
    },
    {
      "id": "auto_app_full",
      "type": "ACTION",
      "metadata": {
        "label": "Generate Full Charity Care Application"
      }
    },
    {
      "id": "auto_app_partial",
      "type": "ACTION",
      "metadata": {
        "label": "Generate Sliding Scale Application"
      }
    },
    {
      "id": "route_to_debt_engine",
      "type": "HANDOFF",
      "metadata": {
        "label": "Route to Debt Cancellation Engine",
        "description": "Patient ineligible for charity care; orchestrator triggers debt_cancellation_engine module."
      }
    },
    {
      "id": "counselor_qa",
      "type": "APPROVAL",
      "metadata": {
        "label": "Counselor QA Review"
      }
    },
    {
      "id": "application_submission",
      "type": "ACTION",
      "metadata": {
        "label": "Submit Application",
        "description": "Transmit application to hospital financial assistance department via portal, fax, or mail with delivery confirmation."
      }
    },
    {
      "id": "submission_confirmed",
      "type": "CONDITION",
      "metadata": {
        "label": "Submission Confirmed?",
        "input_schema": [
          {
            "key": "submission_confirmed",
            "label": "Was the charity care application submitted?",
            "type": "boolean",
            "required": true,
            "description": "Confirm the application was received by the hospital billing office."
          }
        ]
      },
      "condition_field": "submission_confirmed",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "status_poll",
      "false_next": "retry_submission"
    },
    {
      "id": "retry_submission",
      "type": "ACTION",
      "metadata": {
        "label": "Retry Submission",
        "description": "Retry up to 3 times then escalate."
      }
    },
    {
      "id": "status_poll",
      "type": "ACTION",
      "metadata": {
        "label": "Status Poll Loop",
        "description": "Poll hospital weekly for determination (max 60 days)."
      }
    },
    {
      "id": "determination",
      "type": "CONDITION",
      "metadata": {
        "label": "Determination Received?",
        "input_schema": [
          {
            "key": "determination_status",
            "label": "What did the hospital decide on the charity care application?",
            "type": "select",
            "required": true,
            "options": [
              {
                "value": "approved_full",
                "label": "Approved - full write-off"
              },
              {
                "value": "approved_partial",
                "label": "Approved - partial discount"
              },
              {
                "value": "denied",
                "label": "Denied"
              },
              {
                "value": "pending",
                "label": "Still pending"
              }
            ]
          }
        ]
      },
      "condition_field": "determination_status",
      "condition_operator": "in",
      "condition_value": [
        "approved_full",
        "approved_partial",
        "denied",
        "pending"
      ],
      "true_next": "determination_router",
      "false_next": "determination_router"
    },
    {
      "id": "determination_router",
      "type": "CONDITION",
      "metadata": {
        "label": "Determination Router"
      },
      "condition_field": "determination_status",
      "condition_operator": "==",
      "condition_value": "denied",
      "true_next": "appeal_decision",
      "false_next": "account_reconciliation"
    },
    {
      "id": "appeal_decision",
      "type": "APPROVAL",
      "metadata": {
        "label": "Appeal Decision",
        "description": "Navigator decides whether to appeal denial.",
        "suggested_questions": [
          "What's the deadline to file an appeal?",
          "What new evidence can we add?",
          "How often do appeals get overturned?",
          "What happens if we don't appeal?"
        ]
      }
    },
    {
      "id": "appeal_loop",
      "type": "ACTION",
      "metadata": {
        "label": "File Charity Care Appeal",
        "description": "Draft and submit appeal with additional documentation."
      }
    },
    {
      "id": "appeal_outcome",
      "type": "CONDITION",
      "metadata": {
        "label": "Appeal Outcome",
        "input_schema": [
          {
            "key": "appeal_status",
            "label": "What was the outcome of the appeal?",
            "type": "select",
            "required": true,
            "options": [
              {
                "value": "overturned",
                "label": "Overturned - appeal won"
              },
              {
                "value": "upheld",
                "label": "Upheld - appeal denied"
              },
              {
                "value": "pending",
                "label": "Still pending"
              }
            ]
          }
        ]
      },
      "condition_field": "appeal_status",
      "condition_operator": "==",
      "condition_value": "overturned",
      "true_next": "account_reconciliation",
      "false_next": "escalation_router"
    },
    {
      "id": "escalation_router",
      "type": "ACTION",
      "metadata": {
        "label": "Escalation Router",
        "description": "Route to IL AG Hospital Uninsured Patient Discount Act enforcement, CFPB, or state regulator."
      }
    },
    {
      "id": "account_reconciliation",
      "type": "ACTION",
      "metadata": {
        "label": "Account Reconciliation",
        "description": "Post charity care write-off against patient account; capture remaining balance."
      }
    },
    {
      "id": "outcome_capture",
      "type": "ACTION",
      "metadata": {
        "label": "Outcome Capture",
        "description": "Record dollars written off, balance remaining, effective date, hospital, KPI tags."
      }
    },
    {
      "id": "patient_notification",
      "type": "ACTION",
      "metadata": {
        "label": "Patient Notification",
        "description": "SMS, email, and voice notification of result in patient's preferred language."
      }
    },
    {
      "id": "remaining_balance_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Remaining Balance > 0?",
        "input_schema": [
          {
            "key": "remaining_balance",
            "label": "Remaining balance the patient still owes after charity care",
            "type": "currency",
            "required": true,
            "description": "Enter 0 if the bill is fully resolved."
          }
        ]
      },
      "condition_field": "remaining_balance",
      "condition_operator": ">",
      "condition_value": 0,
      "true_next": "route_to_debt_engine",
      "false_next": "case_close_success"
    },
    {
      "id": "case_close_success",
      "type": "ACTION",
      "metadata": {
        "label": "Case Close: Success",
        "description": "Close case with reason code RESOLVED_CHARITY_CARE."
      }
    },
    {
      "id": "case_close_no_consent",
      "type": "ACTION",
      "metadata": {
        "label": "Case Close: No Consent",
        "description": "Close case with reason code NO_CONSENT."
      }
    }
  ],
  "edges": [
    {
      "source": "intake_start",
      "target": "identity_verification"
    },
    {
      "source": "identity_verification",
      "target": "hipaa_consent"
    },
    {
      "source": "hipaa_consent",
      "target": "consent_check"
    },
    {
      "source": "consent_check",
      "target": "document_intake",
      "label": "consent granted"
    },
    {
      "source": "consent_check",
      "target": "case_close_no_consent",
      "label": "no consent"
    },
    {
      "source": "document_intake",
      "target": "documents_complete"
    },
    {
      "source": "documents_complete",
      "target": "hospital_policy_lookup",
      "label": "complete"
    },
    {
      "source": "documents_complete",
      "target": "document_followup",
      "label": "incomplete"
    },
    {
      "source": "document_followup",
      "target": "document_followup_timer"
    },
    {
      "source": "document_followup_timer",
      "target": "hospital_policy_lookup",
      "label": "received"
    },
    {
      "source": "document_followup_timer",
      "target": "navigator_outreach",
      "label": "timeout"
    },
    {
      "source": "hospital_policy_lookup",
      "target": "income_verification"
    },
    {
      "source": "income_verification",
      "target": "presumptive_eligibility"
    },
    {
      "source": "presumptive_eligibility",
      "target": "auto_app_full",
      "label": "presumptive"
    },
    {
      "source": "presumptive_eligibility",
      "target": "fpl_tier_check",
      "label": "not presumptive"
    },
    {
      "source": "fpl_tier_check",
      "target": "auto_app_full",
      "label": "below full threshold"
    },
    {
      "source": "fpl_tier_check",
      "target": "sliding_scale_check",
      "label": "above full threshold"
    },
    {
      "source": "sliding_scale_check",
      "target": "auto_app_partial",
      "label": "sliding scale"
    },
    {
      "source": "sliding_scale_check",
      "target": "route_to_debt_engine",
      "label": "ineligible"
    },
    {
      "source": "auto_app_full",
      "target": "counselor_qa"
    },
    {
      "source": "auto_app_partial",
      "target": "counselor_qa"
    },
    {
      "source": "counselor_qa",
      "target": "application_submission",
      "label": "approved"
    },
    {
      "source": "application_submission",
      "target": "submission_confirmed"
    },
    {
      "source": "submission_confirmed",
      "target": "status_poll",
      "label": "confirmed"
    },
    {
      "source": "submission_confirmed",
      "target": "retry_submission",
      "label": "failed"
    },
    {
      "source": "status_poll",
      "target": "determination"
    },
    {
      "source": "determination",
      "target": "determination_router",
      "label": "received"
    },
    {
      "source": "determination_router",
      "target": "appeal_decision",
      "label": "denied"
    },
    {
      "source": "determination_router",
      "target": "account_reconciliation",
      "label": "approved"
    },
    {
      "source": "appeal_decision",
      "target": "appeal_loop",
      "label": "appeal"
    },
    {
      "source": "appeal_decision",
      "target": "escalation_router",
      "label": "no appeal"
    },
    {
      "source": "appeal_loop",
      "target": "appeal_outcome"
    },
    {
      "source": "appeal_outcome",
      "target": "account_reconciliation",
      "label": "overturned"
    },
    {
      "source": "appeal_outcome",
      "target": "escalation_router",
      "label": "upheld"
    },
    {
      "source": "escalation_router",
      "target": "outcome_capture"
    },
    {
      "source": "account_reconciliation",
      "target": "outcome_capture"
    },
    {
      "source": "outcome_capture",
      "target": "patient_notification"
    },
    {
      "source": "patient_notification",
      "target": "remaining_balance_check"
    },
    {
      "source": "remaining_balance_check",
      "target": "route_to_debt_engine",
      "label": "balance > 0"
    },
    {
      "source": "remaining_balance_check",
      "target": "case_close_success",
      "label": "balance = 0"
    }
  ]
}