{
  "module_name": "insurance_appeal_assistant",
  "version": "2.0",
  "description": "End-to-end insurance appeal workflow: denial intake, expanded denial taxonomy, deadline tracking, evidence retrieval, physician letter request, multi-level appeal loop (L1, L2, external review, state complaint), submission, response wait, claim resubmission, outcome capture, and case closure.",
  "nodes": [
    {
      "id": "intake_start",
      "type": "ACTION",
      "metadata": {
        "label": "Case Intake Start",
        "input_schema": [
          {
            "key": "patient_name",
            "label": "Patient name",
            "type": "text",
            "required": true,
            "description": "First and last name as shown on the bill or insurance card."
          },
          {
            "key": "patient_dob",
            "label": "Patient date of birth",
            "type": "date",
            "required": true
          },
          {
            "key": "patient_phone",
            "label": "Best phone number to reach the patient",
            "type": "text",
            "required": false,
            "description": "Optional - so we can follow up if needed."
          }
        ]
      }
    },
    {
      "id": "hipaa_consent",
      "type": "APPROVAL",
      "metadata": {
        "label": "HIPAA & AOR Consent",
        "description": "Authorization of Representative form for payer."
      }
    },
    {
      "id": "denial_intake",
      "type": "ACTION",
      "metadata": {
        "label": "Denial Intake",
        "description": "Collect EOB, denial letter, member ID, claim number, dates of service.",
        "input_schema": [
          {
            "key": "denial_reason",
            "label": "What did the insurance company say?",
            "type": "text",
            "required": true,
            "description": "Copy the denial reason from the EOB or denial letter, in the patient's words if needed."
          },
          {
            "key": "claim_number",
            "label": "Claim number",
            "type": "text",
            "required": true,
            "description": "Found on the EOB or denial letter."
          },
          {
            "key": "denial_letter",
            "label": "Upload the denial letter (optional)",
            "type": "file",
            "required": false
          }
        ]
      }
    },
    {
      "id": "deadline_tracker",
      "type": "ACTION",
      "metadata": {
        "label": "Deadline Tracker",
        "description": "Calculate appeal deadline (typically 180 days for ERISA, varies for Medicare/Medicaid)."
      }
    },
    {
      "id": "deadline_check",
      "type": "CONDITION",
      "metadata": {
        "label": "Within Appeal Window?"
      },
      "condition_field": "days_remaining",
      "condition_operator": ">",
      "condition_value": 0,
      "true_next": "classify_denial",
      "false_next": "good_cause_extension"
    },
    {
      "id": "good_cause_extension",
      "type": "ACTION",
      "metadata": {
        "label": "Good Cause Extension Request"
      }
    },
    {
      "id": "classify_denial",
      "type": "ACTION",
      "metadata": {
        "label": "Denial Classification",
        "description": "Classify into: medical_necessity, prior_auth, experimental, out_of_network, timely_filing, eligibility, duplicate, missing_info, non_covered, step_therapy, formulary, coding_error."
      }
    },
    {
      "id": "denial_router",
      "type": "CONDITION",
      "metadata": {
        "label": "Denial Type Router"
      },
      "condition_field": "denial_type",
      "condition_operator": "switch",
      "condition_value": [
        "medical_necessity",
        "prior_auth",
        "experimental",
        "out_of_network",
        "timely_filing",
        "eligibility",
        "duplicate",
        "missing_info",
        "non_covered",
        "step_therapy",
        "formulary",
        "coding_error"
      ],
      "branches": {
        "medical_necessity": "evidence_retrieval",
        "prior_auth": "prior_auth_evidence",
        "experimental": "experimental_evidence",
        "out_of_network": "nsa_check",
        "timely_filing": "timely_filing_defense",
        "eligibility": "eligibility_defense",
        "duplicate": "duplicate_defense",
        "missing_info": "info_resubmit",
        "non_covered": "benefit_check",
        "step_therapy": "step_therapy_defense",
        "formulary": "formulary_exception",
        "coding_error": "coding_correction"
      }
    },
    {
      "id": "evidence_retrieval",
      "type": "ACTION",
      "metadata": {
        "label": "Clinical Evidence Retrieval",
        "description": "Pull peer-reviewed literature, clinical guidelines (NCCN, ACC, AHA), medical records."
      }
    },
    {
      "id": "physician_letter_request",
      "type": "ACTION",
      "metadata": {
        "label": "Physician Letter of Medical Necessity Request"
      }
    },
    {
      "id": "physician_letter_received",
      "type": "CONDITION",
      "metadata": {
        "label": "Letter Received?"
      },
      "condition_field": "physician_letter_received",
      "condition_operator": "==",
      "condition_value": true,
      "true_next": "draft_appeal",
      "false_next": "draft_appeal"
    },
    {
      "id": "physician_followup",
      "type": "ACTION",
      "metadata": {
        "label": "Physician Office Follow-Up"
      }
    },
    {
      "id": "prior_auth_evidence",
      "type": "ACTION",
      "metadata": {
        "label": "Prior Auth Evidence Pack"
      }
    },
    {
      "id": "experimental_evidence",
      "type": "ACTION",
      "metadata": {
        "label": "Experimental/Investigational Evidence Pack"
      }
    },
    {
      "id": "nsa_check",
      "type": "ACTION",
      "metadata": {
        "label": "No Surprises Act Check & IDR Routing"
      }
    },
    {
      "id": "timely_filing_defense",
      "type": "ACTION",
      "metadata": {
        "label": "Timely Filing Defense"
      }
    },
    {
      "id": "eligibility_defense",
      "type": "ACTION",
      "metadata": {
        "label": "Eligibility Defense"
      }
    },
    {
      "id": "duplicate_defense",
      "type": "ACTION",
      "metadata": {
        "label": "Duplicate Claim Defense"
      }
    },
    {
      "id": "info_resubmit",
      "type": "ACTION",
      "metadata": {
        "label": "Missing Info Resubmission"
      }
    },
    {
      "id": "benefit_check",
      "type": "ACTION",
      "metadata": {
        "label": "Benefit Coverage Verification"
      }
    },
    {
      "id": "step_therapy_defense",
      "type": "ACTION",
      "metadata": {
        "label": "Step Therapy Override Request"
      }
    },
    {
      "id": "formulary_exception",
      "type": "ACTION",
      "metadata": {
        "label": "Formulary Exception Request"
      }
    },
    {
      "id": "coding_correction",
      "type": "ACTION",
      "metadata": {
        "label": "Coding Correction & Resubmit"
      }
    },
    {
      "id": "draft_appeal",
      "type": "ACTION",
      "metadata": {
        "label": "Draft Appeal Letter"
      }
    },
    {
      "id": "counselor_qa",
      "type": "APPROVAL",
      "metadata": {
        "label": "Counselor QA Review"
      }
    },
    {
      "id": "submit_appeal",
      "type": "ACTION",
      "metadata": {
        "label": "Submit Appeal",
        "description": "Submit via payer portal, certified mail, and fax with delivery proof."
      }
    },
    {
      "id": "appeal_level_tag",
      "type": "ACTION",
      "metadata": {
        "label": "Tag Appeal Level (L1/L2/External/State)"
      }
    },
    {
      "id": "response_wait",
      "type": "ACTION",
      "metadata": {
        "label": "Response Wait State",
        "description": "Pre-service: 30 days. Post-service: 60 days. Urgent: 72 hours."
      }
    },
    {
      "id": "response_received",
      "type": "CONDITION",
      "metadata": {
        "label": "Response Received?"
      },
      "condition_field": "appeal_response",
      "condition_operator": "in",
      "condition_value": [
        "overturned",
        "partial",
        "upheld",
        "no_response"
      ],
      "true_next": "appeal_outcome_router",
      "false_next": "appeal_outcome_router"
    },
    {
      "id": "appeal_outcome_router",
      "type": "CONDITION",
      "metadata": {
        "label": "Outcome Router"
      },
      "condition_field": "appeal_response",
      "condition_operator": "==",
      "condition_value": "overturned",
      "true_next": "claim_resubmission",
      "false_next": "next_level_decision"
    },
    {
      "id": "next_level_decision",
      "type": "CONDITION",
      "metadata": {
        "label": "Next Appeal Level Available?"
      },
      "condition_field": "next_level",
      "condition_operator": "in",
      "condition_value": [
        "L2",
        "external",
        "state_complaint",
        "none"
      ],
      "true_next": "escalate_level",
      "false_next": "guild_attorney_referral"
    },
    {
      "id": "escalate_level",
      "type": "ACTION",
      "metadata": {
        "label": "Escalate to Next Appeal Level"
      }
    },
    {
      "id": "external_review",
      "type": "ACTION",
      "metadata": {
        "label": "External Independent Review (IRO)"
      }
    },
    {
      "id": "state_complaint",
      "type": "ACTION",
      "metadata": {
        "label": "State Insurance Department Complaint"
      }
    },
    {
      "id": "guild_attorney_referral",
      "type": "HANDOFF",
      "metadata": {
        "label": "Guild Attorney Referral",
        "description": "Refer to FairClaims Guild attorney for ERISA litigation or bad faith claim."
      }
    },
    {
      "id": "claim_resubmission",
      "type": "ACTION",
      "metadata": {
        "label": "Claim Resubmission to Provider",
        "description": "Notify provider to resubmit overturned claim for payment."
      }
    },
    {
      "id": "payment_confirmation",
      "type": "ACTION",
      "metadata": {
        "label": "Payment Confirmation Tracking"
      }
    },
    {
      "id": "outcome_capture",
      "type": "ACTION",
      "metadata": {
        "label": "Outcome Capture",
        "description": "Record overturned/upheld, dollars recovered, days to resolution."
      }
    },
    {
      "id": "patient_notification",
      "type": "ACTION",
      "metadata": {
        "label": "Patient Notification"
      }
    },
    {
      "id": "case_close",
      "type": "ACTION",
      "metadata": {
        "label": "Case Close"
      }
    }
  ],
  "edges": [
